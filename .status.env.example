# Copy to .status.env (gitignored) and fill in. Read by scripts/status.sh,
# scripts/notify.sh and scripts/night-reporter.sh. Values here are DEFAULTS:
# anything already set in the environment wins.
MASTER=user@master-node          # ssh target of the training master
PEER=user@peer-node              # second node, if any
RUN=run-1                        # the run to watch
WORKDIR=ft27b-train              # work dir on the nodes (holds runs/)
SERVE_URL=http://master-node:8000/v1/models   # serving stack health URL, optional
# Notifications (optional). Any command taking the subject as its last
# argument and the body on stdin. Without it, notifications go to
# runs/notifications.log only.
# NOTIFY_CMD="python3 /path/to/send_mail.py --to you@example.com --subject"
# NOTIFY_PREFIX="[my-model]"
# RESULTS_FILE=RESULTS.md        # the reporter's "finished" signal, under ~/WORKDIR
